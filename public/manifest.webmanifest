{
  "id": "templink-pwa-app",
  "name": "TempLink — Ephemeral Privacy Platform",
  "short_name": "TempLink",
  "description": "Temporary private communication without permanent accounts. Connect. Communicate. Disappear.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#05070B",
  "theme_color": "#05070B",
  "categories": ["utilities", "productivity", "security"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Create Private Room",
      "short_name": "Create Room",
      "description": "Quickly start an ephemeral private room",
      "url": "/create",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Join Private Room",
      "short_name": "Join Room",
      "description": "Join an active ephemeral room with a code",
      "url": "/join",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scan QR Code",
      "short_name": "Scan QR",
      "description": "Scan a TempLink room QR code with your camera",
      "url": "/scan",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
