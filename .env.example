# TempLink Environment Configuration

# Next.js Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Worker / Durable Objects Backend URL
# (Leave empty for local Next.js proxy, or set to your deployed Cloudflare Worker domain e.g. https://templink-backend.your-subdomain.workers.dev)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_HOST=

# Cloudflare Production Credentials (Optional for local dev)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Razorpay / Payment Provider Keys (Structured for future integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
